# ==============================================================================
# CONEXIATE BACKEND - VARIABLES DE ENTORNO PARA PRODUCCIÓN (DOKPLOY / VPS)
# ==============================================================================
# Copia estos valores en la pestaña "Environment" de tu aplicación en Dokploy.

# ── Configuración del Servidor y Entorno ──
GIN_MODE=release
SERVER_PORT=8080

# ── Base de Datos PostgreSQL ──
# Si usas PostgreSQL dentro de Dokploy en la misma red de Docker, usa el nombre del servicio (ej. postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIA_POR_UN_PASSWORD_SEGURO_PRODUCCION
DB_NAME=conexiate_db
# Usa 'disable' para conexiones dentro de la red interna de Docker, o 'require' para bases de datos externas cloud (AWS RDS, Supabase, etc.)
DB_SSLMODE=disable

# ── Seguridad y Autenticación JWT ──
# Genera una clave segura de al menos 64 caracteres (ej. ejecutando: openssl rand -hex 32)
JWT_SECRET=CAMBIA_ESTA_CLAVE_SECRETA_POR_UNA_ALEATORIA_DE_PRODUCCION_MINIMO_64_CHARS
JWT_EXPIRATION_HOURS=24

# ── Pasarela de Pagos Wompi (Producción) ──
# Obtén estas llaves en el panel de Wompi en Modo Producción
WOMPI_PUBLIC_KEY=pub_prod_TU_LLAVE_PUBLICA_AQUI
WOMPI_PRIVATE_KEY=prv_prod_TU_LLAVE_PRIVADA_AQUI
WOMPI_EVENTS_SECRET=prod_events_TU_SECRETO_DE_EVENTOS_AQUI
WOMPI_INTEGRITY_SECRET=prod_integrity_TU_SECRETO_DE_INTEGRIDAD_AQUI
WOMPI_SANDBOX=false

# ── Servicio de Correo Electrónico (Resend) ──
# Llave de API y remitente con dominio verificado en Resend
RESEND_API_KEY=re_TU_API_KEY_DE_RESEND
RESEND_FROM_EMAIL=notificaciones@tudominio.com

# ── URL Pública del Frontend (Para links de activación y redirecciones) ──
FRONTEND_URL=https://app.tudominio.com
